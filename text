local function CreateSlider(parent, text, min, max, default, position, callback)
    local Title = Instance.new("TextLabel", parent)
    Title.Size = UDim2.new(0.95, 0, 0, 20)
    Title.Position = position
    Title.Text = text .. " : " .. default
    Title.TextColor3 = Color3.fromRGB(200, 200, 200)
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Font = Enum.Font.Gotham

    local SliderBar = Instance.new("TextButton", parent)
    SliderBar.Size = UDim2.new(0.95, 0, 0, 6)
    SliderBar.Position = position + UDim2.new(0, 0, 0, 24)
    SliderBar.BackgroundColor3 = Color3.fromRGB(35, 36, 39)
    SliderBar.Text = ""
    Instance.new("UICorner", SliderBar)

    local Progress = Instance.new("Frame", SliderBar)
    Progress.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    Progress.BackgroundColor3 = Color3.fromRGB(255, 0, 85)
    Instance.new("UICorner", Progress)

    local function update(input)
        local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
        Progress.Size = UDim2.new(pos, 0, 1, 0)
        local val = math.floor(min + (max - min) * pos)
        Title.Text = text .. " : " .. val
        callback(val)
    end

    local dragging = false
    SliderBar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true update(input) end end)
    UIS.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    UIS.InputChanged:Connect(function(input) if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end end)
end

