local function CreateLine(p1, p2, folder)
    local Line = Instance.new("LineHandleAdornment", folder)
    Line.Length, Line.Thickness, Line.ZIndex, Line.AlwaysOnTop = 0, 2, 5, true
    Line.Color3 = Color3.fromRGB(255, 0, 85)
    
    local c
    c = RunService.RenderStepped:Connect(function()
        if not p1 or not p2 or not p1.Parent or not p2.Parent or not Line.Parent then c:Disconnect() pcall(function() Line:Destroy() end) return end
        if ESP_Config.SKELETON then
            Line.Visible = true
            Line.Length = (p1.Position - p2.Position).Magnitude
            Line.CFrame = CFrame.lookAt(p1.Position, p2.Position)
            Line.Adornee = p1
        else Line.Visible = false end
    end)
end

