local function CreateToggle(parent, text, position, configKey)
    local TglBtn = Instance.new("TextButton", parent)
    TglBtn.Size = UDim2.new(0.45, 0, 0, 32)
    TglBtn.Position = position
    TglBtn.BackgroundColor3 = Color3.fromRGB(22, 23, 25)
    TglBtn.Text = "  " .. text .. " [OFF]"
    TglBtn.TextColor3 = Color3.fromRGB(200, 60, 60)
    TglBtn.TextSize = 12
    TglBtn.Font = Enum.Font.Gotham
    TglBtn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", TglBtn).CornerRadius = UDim.new(0, 5)

    TglBtn.MouseButton1Click:Connect(function()
        ESP_Config[configKey] = not ESP_Config[configKey]
        if ESP_Config[configKey] then
            TglBtn.Text = "  " .. text .. " [ON]"
            TglBtn.TextColor3 = Color3.fromRGB(0, 255, 140)
            TglBtn.BackgroundColor3 = Color3.fromRGB(26, 35, 30)
        else
            TglBtn.Text = "  " .. text .. " [OFF]"
            TglBtn.TextColor3 = Color3.fromRGB(200, 60, 60)
            TglBtn.BackgroundColor3 = Color3.fromRGB(22, 23, 25)
        end
    end)
end

